# Use a dedicated bucket when available. If omitted, S3_BUCKET is used.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/postgres
BACKUP_ENVIRONMENT=production

# Optional when the matching PostgreSQL tools are already in PATH.
BACKUP_PG_DUMP_PATH=/usr/bin/pg_dump
BACKUP_PG_RESTORE_PATH=/usr/bin/pg_restore
BACKUP_PSQL_PATH=/usr/bin/psql
BACKUP_AWS_CLI_PATH=/usr/bin/aws

# Optional explicit S3 encryption. Prefer bucket-level default encryption.
BACKUP_S3_SSE=
BACKUP_S3_KMS_KEY_ID=

AWS_REGION=eu-central-1
S3_BUCKET=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
