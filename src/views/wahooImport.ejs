<!DOCTYPE html>
<html lang="<%= i18n?.locale || 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/favicon") %>
    <title><%= t("uploadPage.wahoo.pageTitle") %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/ui-system.css?v=atlas-blue-4">
    <link rel="stylesheet" href="/css/upload.css?v=separate-import-1">
</head>
<body class="upload-page" data-import-layout="simple">
    <%- include("partials/app-topbar", {
        title: t("uploadPage.wahoo.pageTitle"),
        currentPage: "upload",
        userInfo,
        showDashboardNewLink: true
    }) %>
    <main class="container-fluid px-3 px-xl-4 py-4 upload-client-container">
        <div id="upload-shell" class="upload-shell ui-page-shell">
            <section class="upload-hero ui-hero ui-hero--compact">
                <div>
                    <h1 class="upload-title ui-hero__title"><%= t("uploadPage.wahoo.pageTitle") %></h1>
                    <p class="upload-subtitle ui-hero__subtitle"><%= t("uploadPage.wahoo.pageCopy") %></p>
                </div>
            </section>
            <section class="upload-stage ui-surface ui-surface--gradient" aria-labelledby="wahoo-import-title">
                <div class="upload-stage-body">
                    <h2 id="wahoo-import-title" class="h5"><%= t("uploadPage.wahoo.title") %></h2>
                    <p class="small"><%= t(wahooConfigured ? "uploadPage.wahoo.connectionSaved" : "uploadPage.wahoo.connectionMissing") %></p>
                    <a class="small mb-3" href="/profile#wahoo-settings"><%= t(wahooConfigured ? "uploadPage.wahoo.setup" : "uploadPage.wahoo.connect") %></a>
                    <% if (wahooConfigured) { %>
                        <div class="mt-3">
                            <button id="wahoo-load" type="button" class="btn btn-outline-primary"><%= t("uploadPage.wahoo.load") %></button>
                        </div>
                        <p id="wahoo-import-status" class="small mt-2" role="status"></p>
                        <ul id="wahoo-activities" class="list-group garmin-activity-list mb-3" tabindex="0" aria-labelledby="wahoo-import-title"></ul>
                        <div>
                            <button id="wahoo-load-more" type="button" class="btn btn-outline-primary mb-3" hidden disabled><%= t("uploadPage.wahoo.loadMore") %></button>
                        </div>
                        <div id="wahoo-selection-toolbar" class="d-flex gap-2 align-items-center mb-3" hidden>
                            <button id="wahoo-select-all" type="button" class="workout-library-bulk-icon-button btn btn-sm btn-outline-secondary" title="<%= t('uploadPage.wahoo.selectAll') %>" aria-label="<%= t('uploadPage.wahoo.selectAll') %>">
                                <svg viewBox="0 0 20 20" aria-hidden="true">
                                    <rect x="3.25" y="3.25" width="13.5" height="13.5" rx="3" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
                                    <path d="M6.9 10.2L9.2 12.5L13.5 8.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                                    <path d="M5.2 6.3H2.8M5.2 10H2.8M5.2 13.7H2.8" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
                                </svg>
                            </button>
                            <button id="wahoo-unselect-all" type="button" class="workout-library-bulk-icon-button btn btn-sm btn-outline-secondary" title="<%= t('uploadPage.wahoo.unselectAll') %>" aria-label="<%= t('uploadPage.wahoo.unselectAll') %>">
                                <svg viewBox="0 0 20 20" aria-hidden="true">
                                    <path d="M5.5 5.5L14.5 14.5M14.5 5.5L5.5 14.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                    <rect x="3.25" y="3.25" width="13.5" height="13.5" rx="3" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
                                </svg>
                            </button>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="overwriteExistingWorkouts" aria-describedby="wahoo-overwrite-help">
                            <label class="form-check-label" for="overwriteExistingWorkouts"><%= t("uploadPage.woaOverwriteExisting") %></label>
                            <div id="wahoo-overwrite-help" class="form-text"><%= t("uploadPage.woaOverwriteExistingHelp") %></div>
                        </div>
                        <button id="wahoo-import-selected" type="button" class="btn upload-primary-btn align-self-start" disabled><%= t("uploadPage.wahoo.importSelected") %></button>
                        <p class="small text-muted mt-2"><%= t("uploadPage.wahoo.keepOpen") %></p>
                        <%- include("partials/import-progress") %>
                        <div id="response" class="mt-3"></div>
                    <% } %>
                </div>
            </section>
        </div>
    </main>
    <script>
        window.__I18N = <%- JSON.stringify(i18n || { locale: "en", messages: {} }).replace(/</g, "\\u003c") %>;
    </script>
    <script id="wahoo-import-messages" type="application/json"><%- JSON.stringify(i18n?.messages?.uploadPage?.wahoo || {}).replace(/</g, "\\u003c") %></script>
    <% if (wahooConfigured) { %>
        <script type="module" src="/js/wahoo-import-page.js?v=separate-import-1"></script>
    <% } %>
</body>
</html>
