<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/favicon") %>
    <title><%= t("profile.title") %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/ui-system.css?v=atlas-blue-4">
    <link rel="stylesheet" href="/css/profile.css?v=facets-1">
</head>

<body class="profile-page">

    <%- include("partials/app-topbar", {
        title: t("profile.topbarTitle"),
        currentPage: "profile",
        userInfo: userInfo,
        showDashboardNewLink: true,
        showSegmentsLink: true,
        showAnalyticsLink: true,
        showUploadLink: true,
        showGroupsLink: true
    }) %>

    <main class="container-xl py-4">
        <div class="profile-shell ui-page-shell">
            <section class="profile-hero ui-hero ui-hero--compact">
                <div>
                    <p class="profile-kicker ui-hero__kicker"><%= t("profile.heroKicker") %></p>
                    <h1 class="profile-title ui-hero__title"><%= t("profile.heroTitle") %></h1>
                    <p class="profile-subtitle ui-hero__subtitle">
                        <%= t("profile.heroSubtitle") %>
                    </p>
                </div>
            </section>

            <% const facets = ["personal", "weight-history", "preferences", "connections", "membership", "account"]; %>
            <div class="profile-facets" data-profile-facets>
                <nav class="profile-facet-nav" aria-label="<%= t('profile.facets.navigation') %>">
                    <div class="profile-facet-links">
                        <% facets.forEach(facet => { %>
                            <a id="profile-nav-<%= facet %>" href="#<%= facet %>" data-profile-link><%= t(`profile.facets.${facet}`) %></a>
                        <% }) %>
                    </div>
                    <div class="profile-facet-mobile">
                        <label class="form-label" for="profile-facet-select"><%= t('profile.facets.navigation') %></label>
                        <select id="profile-facet-select" class="form-select" data-profile-select>
                            <% facets.forEach(facet => { %>
                                <option value="<%= facet %>"><%= t(`profile.facets.${facet}`) %></option>
                            <% }) %>
                        </select>
                    </div>
                </nav>
                <div class="profile-facet-content">
                    <div id="profile-error" class="alert alert-danger d-none mb-0" role="alert"></div>
                    <div id="profile-success" class="alert alert-success d-none mb-0" role="status"><%= t("profile.saved") %></div>
                    <% facets.forEach(facet => { %>
                        <div id="<%= facet %>" class="profile-facet-panel" data-profile-panel role="region" aria-labelledby="profile-nav-<%= facet %>">
                            <%- include(`partials/profile/${facet}`) %>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </main>

    <script>
        window.profileMessages = {
            loading: "<%= t('profile.ui.loading') %>",
            saving: "<%= t('profile.ui.saving') %>",
            save: "<%= t('profile.save') %>",
            loadProfileError: "<%= t('profile.ui.loadProfileError') %>",
            saveProfileError: "<%= t('profile.ui.saveProfileError') %>",
            profileSaved: "<%= t('profile.saved') %>",
            languageUpdatedReloading: "<%= t('profile.ui.languageUpdatedReloading') %>",
            noActiveSubscription: "<%= t('profile.ui.noActiveSubscription') %>",
            currentPlan: "<%= t('profile.ui.currentPlan') %>",
            loadPlansError: "<%= t('profile.ui.loadPlansError') %>",
            noPlansAvailable: "<%= t('profile.ui.noPlansAvailable') %>",
            active: "<%= t('profile.ui.active') %>",
            upgradeWithPayPal: "<%= t('profile.ui.upgradeWithPayPal') %>",
            starting: "<%= t('profile.ui.starting') %>",
            startCheckoutError: "<%= t('profile.ui.startCheckoutError') %>",
            checkoutCanceled: "<%= t('profile.ui.checkoutCanceled') %>",
            incompleteReturnParameters: "<%= t('profile.ui.incompleteReturnParameters') %>",
            paymentSuccess: "<%= t('profile.ui.paymentSuccess') %>",
            paymentConfirmError: "<%= t('profile.ui.paymentConfirmError') %>",
            missingApprovalUrl: "<%= t('profile.ui.missingApprovalUrl') %>",
            usageWarningPrefix: "<%= t('profile.ui.usageWarningPrefix') %>",
            includedLimits: "<%= t('profile.ui.includedLimits') %>",
            usageOverview: "<%= t('profile.ui.usageOverview') %>",
            nearLimit: "<%= t('profile.ui.nearLimit') %>",
            limitExceeded: "<%= t('profile.ui.limitExceeded') %>",
            freeTierName: "<%= t('profile.ui.freeTierName') %>",
            expiredPlan: "<%= t('profile.ui.expiredPlan') %>",
            validUntil: "<%= t('profile.ui.validUntil') %>",
            starterDescription: "<%= t('profile.ui.starterDescription') %>",
            featurePlanGenerations: "<%= t('profile.ui.featurePlanGenerations') %>",
            featureCoachCommentary: "<%= t('profile.ui.featureCoachCommentary') %>",
            featureSavedPlans: "<%= t('profile.ui.featureSavedPlans') %>",
            featureStoredWorkouts: "<%= t('profile.ui.featureStoredWorkouts') %>",
            deletionPendingTitle: "<%= t('profile.ui.deletionPendingTitle') %>",
            deletionPendingCopy: "<%= t('profile.ui.deletionPendingCopy') %>",
            deletionRequestCopy: "<%= t('profile.ui.deletionRequestCopy') %>",
            deletionRequested: "<%= t('profile.ui.deletionRequested') %>",
            deletionCanceled: "<%= t('profile.ui.deletionCanceled') %>",
            deletionRequestError: "<%= t('profile.ui.deletionRequestError') %>",
            deletionCancelError: "<%= t('profile.ui.deletionCancelError') %>",
            deletionRequestConfirm: "<%= t('profile.ui.deletionRequestConfirm') %>",
            deletionCancelConfirm: "<%= t('profile.ui.deletionCancelConfirm') %>",
            deletionReadOnly: "<%= t('profile.ui.deletionReadOnly') %>"
        };

        // Defensive cleanup: if a previous page left a modal backdrop behind,
        // the profile page must never look like a modal overlay.
        document.body.classList.remove("modal-open");
        document.body.style.removeProperty("padding-right");
        document.querySelectorAll(".modal-backdrop").forEach((node) => node.remove());
    </script>
    <script id="weight-history-messages" type="application/json"><%- JSON.stringify({locale: typeof locale !== "undefined" ? locale : "en", validFrom: t("profile.weightHistory.date"), cancel: t("profile.ui.cancelAction"), edit: t("profile.weightHistory.edit"),delete: t("profile.weightHistory.delete"),confirmDelete: t("profile.weightHistory.confirmDelete"),empty: t("profile.weightHistory.empty"),saved: t("profile.weightHistory.saved"),error: t("profile.weightHistory.error")}).replace(/</g, "\\u003c") %></script>
    <script src="/js/profile-facets.js?v=2" type="module"></script>
    <script src="/js/weight-history-ui.js" type="module"></script>
    <script id="garmin-settings-messages" type="application/json"><%- JSON.stringify(Object.fromEntries(["configured", "empty", "saved", "removed", "error", "unavailable", "remove", "confirmDelete", "cancel"].map(key => [key, t(`profile.garmin.${key}`)]))).replace(/</g, "\\u003c") %></script>
    <script src="/js/garmin-settings-ui.js" type="module"></script>
    <script id="wahoo-settings-messages" type="application/json"><%- JSON.stringify(Object.fromEntries(["configured", "empty", "connected", "denied", "error", "unavailable", "remove", "removed", "confirmDelete", "cancel", "reconnect", "offlineRequired", "webhookUnavailable", "autoImportSaved", "autoImportHelp"].map(key => [key, t(`profile.wahoo.${key}`)]))).replace(/</g, "\\u003c") %></script>
    <script src="/js/wahoo-settings-ui.js?v=2" type="module"></script>
    <script src="/js/profile-ui.js?v=required-weight-1" type="module"></script>
</body>

</html>
