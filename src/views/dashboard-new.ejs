                                                    <div class="dashboard-actions-menu__group-label"><%= t("dashboardNewPage.gpsTrackMenu") %></div>
                                                    <button class="dashboard-actions-menu__item" type="button" data-gpx-import-mode="exact">
                                                        <%= t("dashboardNewPage.gpxImportExact") %>
                                                    </button>
                                                    <button class="dashboard-actions-menu__item" type="button" data-gpx-import-mode="routed">
                                                        <%= t("dashboardNewPage.gpxImportRouted") %>
                                                    </button>
                                                    <button id="dashboard-copy-gps-open" class="dashboard-actions-menu__item" type="button">
                                                        <%= t("dashboardNewPage.copyGpsOpen") %>
                                                    </button>
                                                    <button id="dashboard-manual-gps-toggle" class="dashboard-actions-menu__item" type="button">
                                                        <%= t("dashboardNewPage.manualGpsCreate") %>
                                                    </button>
                                                </div>
                                            </div>
                                        </details>
                                        <input id="dashboard-gpx-file" class="d-none" type="file" accept=".gpx,application/gpx+xml">
                                        <button id="dashboard-manual-gps-clear" class="btn btn-outline-secondary btn-sm d-none" type="button">
                                            <%= t("dashboardNewPage.manualGpsClear") %>
                                        </button>
                                        <button id="dashboard-manual-gps-cancel" class="btn btn-outline-secondary btn-sm d-none" type="button">
                                            <%= t("dashboardNewPage.manualGpsCancel") %>
                                        </button>
                                        <button id="dashboard-manual-gps-save" class="btn btn-primary btn-sm d-none" type="button" disabled>
                                            <%= t("dashboardNewPage.manualGpsSave") %>
                                        </button>
                                        <details id="dashboard-map-style-menu" class="dashboard-actions-menu dashboard-actions-menu--map">
                                            <summary class="dashboard-actions-menu__trigger" aria-label="<%= t('dashboardNewPage.mapStyleAria') %>">
                                                <span></span><span></span><span></span>
                                            </summary>
                                            <div class="dashboard-actions-menu__panel">
                                                <div class="dashboard-actions-menu__group">
                                                    <div class="dashboard-actions-menu__group-label"><%= t("dashboardNewPage.mapStyleLabel") %></div>
                                                    <div id="dashboard-map-style-slot" class="dashboard-actions-menu__series-slot"></div>
                                                </div>
                                            </div>
                                        </details>
                                    </div>
                                </div>

                            <div class="dashboard-surface-body ui-surface-body ui-surface-body--flush">
                                    <div id="dashboard-manual-gps-hint" class="dashboard-map-hint d-none"><%= t("dashboardNewPage.manualGpsHint") %></div>
                                    <div id="workout-map"></div>
                                </div>
                            </aside>
                        </div>

                        <div class="dashboard-detail-side-stack">
                            <article id="dashboard-workout-segments-panel" class="dashboard-surface dashboard-detail-panel dashboard-workout-segments-panel">
                                <div class="dashboard-section-header">
                                    <div>
                                        <span class="dashboard-eyebrow"><%= t("dashboardNewPage.workoutSegmentsEyebrow") %></span>
                                        <h2 class="dashboard-section-title"><%= t("dashboardNewPage.workoutSegmentsTitle") %></h2>
                                        <p id="dashboard-workout-segments-copy" class="dashboard-section-copy"><%= t("dashboardNewPage.workoutSegmentsCopy") %></p>
                                    </div>
                                </div>
                                <div class="dashboard-surface-body">
                                    <div id="dashboard-workout-segments-list" class="dashboard-workout-segments-list">
                                        <div class="dashboard-workout-segments-empty"><%= t("dashboardNewPage.workoutSegmentsEmpty") %></div>
                                    </div>
                                </div>
                            </article>

                            <article id="dashboard-similar-workouts-panel" class="dashboard-surface dashboard-detail-panel dashboard-similar-workouts-panel">
                                <div class="dashboard-section-header">
                                    <div>
                                        <span class="dashboard-eyebrow"><%= t("dashboardNewPage.similarWorkoutsEyebrow") %></span>
                                        <h2 class="dashboard-section-title"><%= t("dashboardNewPage.similarWorkoutsTitle") %></h2>
                                        <p id="dashboard-similar-workouts-copy" class="dashboard-section-copy"><%= t("dashboardNewPage.similarWorkoutsCopy") %></p>
                                    </div>
                                </div>
                                <div class="dashboard-surface-body">
                                    <div id="dashboard-similar-workouts-list" class="dashboard-similar-workouts-list">
                                        <div class="dashboard-similar-workouts-empty"><%= t("dashboardNewPage.similarWorkoutsEmpty") %></div>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </section>
                </section>
                <div id="dashboard-mobile-library-backdrop" class="dashboard-mobile-library-backdrop"></div>
            </div>

        </div>

        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div id="dashboard-toast" class="toast dashboard-toast border-0" role="alert" aria-live="assertive"
                aria-atomic="true">
                <div class="toast-body" id="dashboard-toast-body"></div>
            </div>
        </div>

        <div class="modal fade" id="dashboard-add-training-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow dashboard-add-training-modal">
                    <div class="modal-header">
                        <div>
                            <p class="dashboard-eyebrow mb-1"><%= t("dashboardNewPage.addTrainingEyebrow") %></p>
                            <h2 class="modal-title mb-0"><%= t("dashboardNewPage.addTrainingTitle") %></h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="dashboard-section-copy mb-3"><%= t("dashboardNewPage.addTrainingCopy") %></p>
                        <div class="dashboard-add-training-options">
                            <a class="dashboard-add-training-option" href="/files/uploadUI">
                                <span class="dashboard-add-training-option__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M12 16V4M7.5 8.5 12 4l4.5 4.5M5 14.5v4h14v-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                </span>
                                <span>
                                    <strong><%= t("dashboardNewPage.addTrainingRecordingImportTitle") %></strong>
                                    <small><%= t("dashboardNewPage.addTrainingImportCopy") %></small>
                                </span>
                            </a>
                            <button id="dashboard-add-manual-training" class="dashboard-add-training-option" type="button">
                                <span class="dashboard-add-training-option__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M6 18.5h3l9-9-3-3-9 9v3zM13.8 7.7l3 3M5 21h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                </span>
                                <span>
                                    <strong><%= t("dashboardNewPage.addTrainingManualTitle") %></strong>
                                    <small><%= t("dashboardNewPage.addTrainingManualCopy") %></small>
                                </span>
                            </button>
                            <button id="dashboard-import-manual-training" class="dashboard-add-training-option" type="button">
                                <span class="dashboard-add-training-option__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19h14M7 5h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                </span>
                                <span>
                                    <strong><%= t("dashboardNewPage.manualActivityImportOptionTitle") %></strong>
                                    <small><%= t("dashboardNewPage.manualActivityImportOptionCopy") %></small>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="dashboard-manual-import-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow dashboard-manual-import-modal">
                    <div class="modal-header">
                        <div>
                            <p class="dashboard-eyebrow mb-1"><%= t("dashboardNewPage.addTrainingEyebrow") %></p>
                            <h2 class="modal-title mb-0"><%= t("dashboardNewPage.manualActivityImportTitle") %></h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="dashboard-section-copy"><%= t("dashboardNewPage.manualActivityImportCopy") %></p>
                        <label class="dashboard-manual-import-picker">
                            <span><%= t("dashboardNewPage.manualActivityImportChoose") %></span>
                            <input id="dashboard-manual-import-file" class="form-control" type="file" accept=".json,.zip,application/json,application/zip">
                        </label>
                        <div id="dashboard-manual-import-error" class="alert alert-danger d-none mt-3" role="alert"></div>
                        <div id="dashboard-manual-import-preview" class="dashboard-manual-import-preview d-none mt-3" aria-live="polite"></div>
                        <label class="form-check dashboard-manual-import-overwrite mt-3">
                            <input id="dashboard-manual-import-overwrite" class="form-check-input" type="checkbox">
                            <span class="form-check-label"><%= t("dashboardNewPage.manualActivityImportOverwrite") %></span>
                        </label>
                    </div>
                    <div class="modal-footer">
                        <button id="dashboard-manual-import-back" class="btn btn-outline-secondary" type="button"><%= t("dashboardNewPage.manualTrainingBack") %></button>
                        <button id="dashboard-manual-import-submit" class="btn btn-primary" type="button" disabled><%= t("dashboardNewPage.manualActivityImportSubmit") %></button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="dashboard-manual-training-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow dashboard-manual-training-modal">
                    <form id="dashboard-manual-training-form">
                        <div class="modal-header">
                            <div>
                                <p class="dashboard-eyebrow mb-1"><%= t("dashboardNewPage.addTrainingEyebrow") %></p>
                                <h2 id="dashboard-manual-training-title" class="modal-title mb-0"><%= t("dashboardNewPage.manualTrainingTitle") %></h2>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div id="dashboard-manual-training-error" class="alert alert-danger d-none" role="alert"></div>
                            <div class="dashboard-manual-training-grid">
                                <label class="dashboard-manual-training-field">
                                    <span><%= t("dashboardNewPage.manualTrainingStart") %></span>
                                    <input class="form-control" name="startTime" type="datetime-local" required>
                                </label>
                                <label class="dashboard-manual-training-field">
                                    <span><%= t("dashboardNewPage.manualTrainingDuration") %></span>
                                    <input class="form-control" name="durationMinutes" type="number" min="1" max="10080" step="1" required>
                                </label>
                                <label class="dashboard-manual-training-field">
                                    <span><%= t("dashboardNewPage.manualTrainingActivityType") %></span>
                                    <select id="dashboard-manual-training-type" class="form-select" name="activityType" required>
                                        <option value="cycling"><%= t("dashboardNewPage.activityTypeCycling") %></option>
                                        <option value="strength_training"><%= t("dashboardNewPage.activityTypeStrengthTraining") %></option>
                                        <option value="mobility"><%= t("dashboardNewPage.activityTypeMobility") %></option>
                                        <option value="other"><%= t("dashboardNewPage.activityTypeOther") %></option>
                                    </select>
                                </label>
                                <label id="dashboard-manual-workout-type-field" class="dashboard-manual-training-field">
                                    <span><%= t("dashboardNewPage.workoutTypeFilterLabel") %></span>
                                    <select class="form-select" name="workoutType">
                                        <option value="indoor"><%= t("dashboardNewPage.workoutTypeIndoor") %></option>
                                        <option value="road"><%= t("dashboardNewPage.workoutTypeRoad") %></option>
                                        <option value="mountain"><%= t("dashboardNewPage.workoutTypeMountain") %></option>
                                        <option value="unknown"><%= t("dashboardNewPage.workoutTypeUnknown") %></option>
                                    </select>
                                </label>
                                <label class="dashboard-manual-training-field">
                                    <span><%= t("dashboardNewPage.manualTrainingRpe") %></span>
                                    <input class="form-control" name="perceivedExertion" type="number" min="1" max="10" step="1" placeholder="1–10">
                                </label>
                                <label id="dashboard-manual-baseline-power-field" class="dashboard-manual-training-field">
                                    <span><%= t("dashboardNewPage.manualTrainingBaselinePower") %></span>
                                    <div class="input-group">
                                        <input class="form-control" name="baselinePowerValue" type="number" min="1" max="3000" step="1" required>
                                        <select id="dashboard-manual-baseline-power-mode" class="form-select dashboard-manual-power-mode" name="baselinePowerMode" aria-label="<%= t("dashboardNewPage.manualTrainingPowerMode") %>">
                                            <option value="watts"><%= t("dashboardNewPage.manualTrainingWatts") %></option>
                                            <option value="ftp_percent"><%= t("dashboardNewPage.manualTrainingFtpPercent") %></option>
                                        </select>
                                    </div>
                                </label>
                                <label id="dashboard-manual-tss-field" class="dashboard-manual-training-field">
                                    <span><%= t("dashboardNewPage.manualTrainingTssOverride") %></span>
                                    <input class="form-control" name="estimatedTss" type="number" min="0" max="2000" step="0.1">
                                </label>
                                <section id="dashboard-manual-interval-section" class="dashboard-manual-interval-section dashboard-manual-training-field--wide">
                                    <div class="dashboard-manual-interval-section__head">
                                        <div>
                                            <strong><%= t("dashboardNewPage.manualTrainingIntervals") %></strong>
                                            <small><%= t("dashboardNewPage.manualTrainingIntervalsHint") %></small>
                                        </div>
                                        <button id="dashboard-manual-interval-add" class="btn btn-sm btn-outline-primary" type="button"><%= t("dashboardNewPage.manualTrainingIntervalAdd") %></button>
                                    </div>
                                    <div id="dashboard-manual-interval-list" class="dashboard-manual-interval-list"></div>
                                </section>
                                <label id="dashboard-manual-strength-focus-field" class="dashboard-manual-training-field" hidden>
                                    <span><%= t("dashboardNewPage.manualTrainingStrengthFocus") %></span>
                                    <select class="form-select" name="strengthFocus">
                                        <option value=""><%= t("dashboardNewPage.manualTrainingNotSpecified") %></option>
                                        <option value="upper_body"><%= t("dashboardNewPage.strengthFocusUpperBody") %></option>
                                        <option value="lower_body"><%= t("dashboardNewPage.strengthFocusLowerBody") %></option>
                                        <option value="full_body"><%= t("dashboardNewPage.strengthFocusFullBody") %></option>
                                    </select>
                                </label>
                                <label class="dashboard-manual-training-field dashboard-manual-training-field--wide">
                                    <span><%= t("dashboardNewPage.manualTrainingName") %></span>
                                    <input class="form-control" name="title" type="text" maxlength="160">
                                </label>
                                <label class="dashboard-manual-training-field dashboard-manual-training-field--wide">
                                    <span><%= t("dashboardNewPage.manualTrainingNotes") %></span>
                                    <textarea class="form-control" name="notes" rows="3" maxlength="5000"></textarea>
                                </label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="dashboard-manual-training-back" type="button" class="btn btn-outline-secondary"><%= t("dashboardNewPage.manualTrainingBack") %></button>
                            <button id="dashboard-manual-training-submit" type="submit" class="btn btn-primary"><%= t("dashboardNewPage.manualTrainingSave") %></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="dashboard-manual-copy-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow dashboard-manual-copy-modal">
                    <div class="modal-header">
                        <div>
                            <p class="dashboard-eyebrow mb-1"><%= t("dashboardNewPage.manualTrainingCopyEyebrow") %></p>
                            <h2 class="modal-title mb-0"><%= t("dashboardNewPage.manualTrainingCopyTitle") %></h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="dashboard-manual-copy-error" class="alert alert-danger d-none" role="alert"></div>
                        <p id="dashboard-manual-copy-source" class="dashboard-manual-copy-source"></p>
                        <div class="dashboard-manual-copy-layout">
                            <section class="dashboard-manual-copy-calendar" aria-label="<%= t("dashboardNewPage.manualTrainingCopyCalendarLabel") %>">
                                <div class="dashboard-manual-copy-calendar__head">
                                    <button id="dashboard-manual-copy-prev" class="btn btn-sm btn-outline-secondary" type="button" aria-label="<%= t("dashboardNewPage.manualTrainingCopyPreviousMonth") %>">‹</button>
                                    <strong id="dashboard-manual-copy-month"></strong>
                                    <button id="dashboard-manual-copy-next" class="btn btn-sm btn-outline-secondary" type="button" aria-label="<%= t("dashboardNewPage.manualTrainingCopyNextMonth") %>">›</button>
                                </div>
                                <div id="dashboard-manual-copy-weekdays" class="dashboard-manual-copy-weekdays"></div>
                                <div id="dashboard-manual-copy-days" class="dashboard-manual-copy-days"></div>
                            </section>
                            <aside class="dashboard-manual-copy-selection">
                                <div class="dashboard-manual-copy-selection__head">
                                    <strong><%= t("dashboardNewPage.manualTrainingCopySelected") %></strong>
                                    <span id="dashboard-manual-copy-count">0/50</span>
                                </div>
                                <p id="dashboard-manual-copy-empty" class="dashboard-section-copy"><%= t("dashboardNewPage.manualTrainingCopyEmpty") %></p>
                                <div id="dashboard-manual-copy-selected" class="dashboard-manual-copy-selected"></div>
                            </aside>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("dashboardNewPage.manualTrainingCancel") %></button>
                        <button id="dashboard-manual-copy-submit" type="button" class="btn btn-primary" disabled><%= t("dashboardNewPage.manualTrainingCopySubmit") %></button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="dashboard-gps-copy-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow dashboard-gps-copy-modal">
                    <div class="modal-header">
                        <div>
                            <p class="dashboard-eyebrow mb-1"><%= t("dashboardNewPage.copyGpsEyebrow") %></p>
                            <h2 class="modal-title mb-0"><%= t("dashboardNewPage.copyGpsTitle") %></h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p id="dashboard-gps-copy-copy" class="dashboard-section-copy mb-3"><%= t("dashboardNewPage.copyGpsCopy") %></p>
                        <div id="dashboard-gps-copy-status" class="dashboard-gps-copy-status d-none"></div>
                        <div id="dashboard-gps-copy-candidates" class="dashboard-gps-copy-candidates"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade dashboard-3d-modal" id="dashboard-3d-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen-lg-down modal-xl modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header">
                        <div>
                            <p class="dashboard-eyebrow mb-1"><%= t("dashboardNewPage.map3dEyebrow") %></p>
                            <h2 class="modal-title mb-0"><%= t("dashboardNewPage.map3dTitle") %></h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="dashboard-3d-modal__stage">
                            <div id="dashboard-3d-map" class="dashboard-3d-modal__map"></div>
                            <div class="dashboard-3d-modal__controls">
                                <button id="dashboard-3d-play-toggle" class="dashboard-3d-modal__play" type="button" aria-pressed="false" title="<%= t('dashboardNewPage.map3dPlay') %>">
                                    <span class="dashboard-3d-modal__play-icon dashboard-3d-modal__play-icon--play" aria-hidden="true">▶</span>
                                    <span class="dashboard-3d-modal__play-icon dashboard-3d-modal__play-icon--pause d-none" aria-hidden="true">❚❚</span>
                                    <span class="dashboard-3d-modal__play-label"><%= t("dashboardNewPage.map3dPlay") %></span>
                                </button>
                                <label class="dashboard-3d-modal__preset">
                                    <span class="dashboard-3d-modal__preset-label"><%= t("dashboardNewPage.map3dPresetLabel") %></span>
                                    <select id="dashboard-3d-preset" class="form-select form-select-sm dashboard-3d-modal__preset-select">
                                        <option value="standard"><%= t("dashboardNewPage.map3dPresetStandard") %></option>
                                        <option value="action"><%= t("dashboardNewPage.map3dPresetAction") %></option>
                                        <option value="firstPerson"><%= t("dashboardNewPage.map3dPresetFirstPerson") %></option>
                                        <option value="cinematic"><%= t("dashboardNewPage.map3dPresetCinematic") %></option>
                                        <option value="drone"><%= t("dashboardNewPage.map3dPresetDrone") %></option>
                                    </select>
                                </label>
                            </div>
                            <div class="dashboard-3d-modal__overlay">
                                <div id="dashboard-3d-summary" class="dashboard-3d-modal__summary"><%= t("dashboardNewPage.map3dEmpty") %></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <% } else { %>

            <div class="container py-5 text-center">

                <h3 class="mb-4"><%= t("common.auth.pleaseSignIn") %></h3>

                <a class="btn btn-primary" href="/login">
                    <%= t("dashboardNewPage.signIn") %>
                </a>

            </div>

            <% } %>
                <!-- Charts -->

                <script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
                <script>
                    window.__I18N = <%- JSON.stringify(i18n || { locale: "en", messages: {} }) %>;
                    window.__APP_CONFIG = Object.assign({}, window.__APP_CONFIG, {
                        maptilerApiKey: <%- JSON.stringify(maptilerApiKey || "") %>
                    });
                </script>

                <script type="module" src="/js/dashboard-new-ui.js"></script>

</body>

</html>
