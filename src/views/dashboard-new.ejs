<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/favicon") %>

    <title><%= t("dashboardNewPage.title") %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/ui-system.css?v=atlas-blue-4">
    <link rel="stylesheet" href="/css/dashboard-new.css?v=atlas-blue-5">

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

</head>

<body class="dashboard-page">

    <% if (isAuthenticated) { %>

        <%- include("partials/app-topbar", {
            title: t("dashboardNewPage.topbarTitle"),
            currentPage: "dashboard-new",
            userInfo,
            showDashboardNewLink: true
        }) %>

        <!-- Content -->

        <div class="container-fluid px-3 px-xl-4 py-4">

            <div id="dashboard-shell" class="dashboard-shell">

                <section id="dashboard-hero" class="dashboard-hero">
                    <div>
                        <h1 id="dashboard-workout-count" class="dashboard-title"><%= t("dashboardNewPage.titleMain") %></h1>
                        <div id="dashboard-hero-status" class="dashboard-hero-status" hidden></div>
                        <div id="dashboard-quick-access" class="dashboard-quick-access" hidden>
                            <div class="dashboard-quick-access__group">
                                <span class="dashboard-quick-access__label"><%= t("dashboardNewPage.quickFavorites") %></span>
                                <div id="dashboard-favorite-workouts" class="dashboard-quick-access__links"></div>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-hero-meta">
                        <button
                            id="dashboard-add-training"
                            class="dashboard-add-training-button"
                            type="button"
                            title="<%= t('dashboardNewPage.addTraining') %>">
                            <svg viewBox="0 0 20 20" aria-hidden="true">
                                <path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                            </svg>
                            <span><%= t("dashboardNewPage.addTraining") %></span>
                        </button>
                        <details class="dashboard-export-menu">
                            <summary class="dashboard-export-fit-button" title="<%= t('dashboardNewPage.exportMenu') %>">
                                <svg viewBox="0 0 20 20" aria-hidden="true">
                                    <path d="M10 3.2v8.4M6.8 8.7L10 12l3.2-3.3M4 15.8h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                                <span><%= t("dashboardNewPage.exportMenu") %></span>
                            </summary>
                            <div class="dashboard-export-menu__panel">
                                <button id="dashboard-export-all-fit" type="button"><%= t("dashboardNewPage.exportAllFit") %></button>
                                <button id="dashboard-export-all-manual" type="button"><%= t("dashboardNewPage.exportAllManual") %></button>
                            </div>
                        </details>
                        <div class="workout-library-scope-toggle" role="group" aria-label="<%= t('dashboardNewPage.filterAria') %>">
                            <button
                                id="workout-library-scope-mine"
                                class="btn btn-sm btn-outline-secondary active"
                                type="button"
                                data-workout-scope="mine">
                                <%= t("dashboardNewPage.filterMine") %>
                            </button>
                            <button
                                id="workout-library-scope-shared"
                                class="btn btn-sm btn-outline-secondary"
                                type="button"
                                data-workout-scope="shared">
                                <%= t("dashboardNewPage.filterShared") %>
                            </button>
                            <button
                                id="workout-library-scope-all"
                                class="btn btn-sm btn-outline-secondary"
                                type="button"
                                data-workout-scope="all">
                                <%= t("dashboardNewPage.filterAll") %>
                            </button>
                        </div>
                        <div class="ui-hero__art" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="none">
                                <defs>
                                    <linearGradient id="dashboardHeroWorkoutsGradient" x1="8" y1="50" x2="56" y2="14" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#176fbe" />
                                        <stop offset="1" stop-color="#75b9f5" />
                                    </linearGradient>
                                </defs>
                                <path d="M10 46C16 37 21 30 28 31C34 32 35 42 42 42C48 42 51 32 54 18" stroke="url(#dashboardHeroWorkoutsGradient)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M10 51H54" stroke="rgba(148,163,184,0.38)" stroke-width="3" stroke-linecap="round" />
                                <circle cx="28" cy="31" r="4" fill="#75b9f5" />
                                <circle cx="42" cy="42" r="4" fill="#176fbe" />
                            </svg>
                        </div>
                    </div>
                </section>

                <section id="dashboard-master-detail" class="dashboard-master-detail">
                    <button id="dashboard-mobile-library-toggle" class="btn btn-outline-dark dashboard-mobile-library-toggle" type="button" aria-expanded="false">
                        <%= t("dashboardNewPage.mobileLibraryOpen") %>
                    </button>
                    <div class="dashboard-library-column">
                        <section class="dashboard-section dashboard-library-section">
                            <div class="dashboard-mobile-library-header">
                                <div>
                                    <span class="dashboard-eyebrow"><%= t("dashboardNewPage.libraryTitle") %></span>
                                    <h2 class="dashboard-section-title mb-0"><%= t("dashboardNewPage.libraryTitle") %></h2>
                                </div>
                                <button
                                    id="dashboard-mobile-library-close"
                                    class="dashboard-mobile-library-close"
                                    type="button"
                                    aria-label="<%= t('dashboardNewPage.mobileLibraryClose') %>">
                                    <span aria-hidden="true">×</span>
                                </button>
                            </div>
                            <div class="dashboard-table-body">
                                <div class="workout-library-toolbar">
                                    <div id="workout-library-bulk-bar" class="workout-library-bulk-bar d-none">
                                        <div class="workout-library-bulk-bar__lead">
                                            <button
                                                id="workout-library-bulk-exit"
                                                class="workout-library-selection-toggle workout-library-selection-toggle--exit"
                                                type="button"
                                                aria-label="<%= t('dashboardNewPage.bulkCancel') %>">
                                                <svg viewBox="0 0 20 20" aria-hidden="true">
                                                    <rect x="3.5" y="3.5" width="13" height="13" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
                                                    <path d="M6.4 6.4L13.6 13.6M13.6 6.4L6.4 13.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                                                </svg>
                                            </button>
                                            <span id="workout-library-bulk-count" class="workout-library-bulk-bar__count"><%= t("dashboardNewPage.bulkNoneSelected") %></span>
                                        </div>
                                        <div class="workout-library-bulk-bar__actions">
                                            <div id="workout-library-bulk-share-inline" class="workout-library-bulk-share-inline d-none">
                                                <span class="small text-muted"><%= t("dashboardNewPage.library.visibility") %></span>
                                                <select id="workout-library-bulk-share-mode" class="form-select form-select-sm" style="width: 140px;">
                                                    <option value="private"><%= t("dashboardNewPage.library.sharePrivate") %></option>
                                                    <option value="groups"><%= t("dashboardNewPage.library.shareGroups") %></option>
                                                </select>
                                                <div id="workout-library-bulk-share-groups" class="workout-library-bulk-share-groups"></div>
                                                <button id="workout-library-bulk-share-cancel" class="btn btn-sm btn-outline-secondary" type="button"><%= t("dashboardNewPage.bulkCancel") %></button>
                                                <button id="workout-library-bulk-share-apply" class="btn btn-sm btn-primary" type="button"><%= t("dashboardNewPage.library.apply") %></button>
                                            </div>
                                            <div class="workout-library-bulk-inline-actions">
                                                <button id="workout-library-select-all-visible" class="workout-library-bulk-icon-button btn btn-sm btn-outline-secondary" type="button" title="<%= t('dashboardNewPage.bulkSelectLoaded') %>" aria-label="<%= t('dashboardNewPage.bulkSelectLoaded') %>">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true">
                                                        <rect x="3.25" y="3.25" width="13.5" height="13.5" rx="3" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
                                                        <path d="M6.9 10.2L9.2 12.5L13.5 8.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                                                        <path d="M5.2 6.3H2.8M5.2 10H2.8M5.2 13.7H2.8" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
                                                    </svg>
                                                </button>
                                                <button id="workout-library-clear-selection" class="workout-library-bulk-icon-button btn btn-sm btn-outline-secondary" type="button" title="<%= t('dashboardNewPage.bulkClearSelection') %>" aria-label="<%= t('dashboardNewPage.bulkClearSelection') %>">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true">
                                                        <path d="M5.5 5.5L14.5 14.5M14.5 5.5L5.5 14.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                                        <rect x="3.25" y="3.25" width="13.5" height="13.5" rx="3" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
                                                    </svg>
                                                </button>
                                                <button id="workout-library-bulk-publish-toggle" class="workout-library-bulk-icon-button btn btn-sm btn-outline-secondary" type="button" title="<%= t('dashboardNewPage.bulkPublish') %>" aria-label="<%= t('dashboardNewPage.bulkPublish') %>">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true">
                                                        <path d="M10 3.2V12.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                                                        <path d="M6.8 6.5L10 3.2L13.2 6.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                                                        <rect x="4" y="12.2" width="12" height="4.6" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
                                                    </svg>
                                                </button>
                                                <button id="workout-library-bulk-delete" class="workout-library-bulk-icon-button btn btn-sm btn-outline-danger" type="button" title="<%= t('dashboardNewPage.bulkDelete') %>" aria-label="<%= t('dashboardNewPage.bulkDelete') %>">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true">
                                                        <path d="M6.2 5.5H13.8L13.2 15.3C13.1 16.2 12.4 16.8 11.5 16.8H8.5C7.6 16.8 6.9 16.2 6.8 15.3L6.2 5.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
                                                        <path d="M4.8 5.5H15.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                                                        <path d="M8 5.2V4.5C8 3.8 8.5 3.2 9.2 3.2H10.8C11.5 3.2 12 3.8 12 4.5V5.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="workout-library-toolbar-default" class="workout-library-toolbar__default">
                                        <button
                                            id="workout-library-selection-toggle"
                                            class="workout-library-selection-toggle"
                                            type="button"
                                            aria-pressed="false"
                                            aria-label="<%= t('dashboardNewPage.bulkSelectMode') %>">
                                            <svg viewBox="0 0 20 20" aria-hidden="true">
                                                <rect x="3.5" y="3.5" width="13" height="13" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
                                                <path d="M6.75 10.15L8.95 12.35L13.35 7.95" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                                            </svg>
                                        </button>
                                        <button
                                            id="workout-library-favorites-filter"
                                            class="workout-library-selection-toggle workout-library-selection-toggle--favorite"
                                            type="button"
                                            aria-pressed="false"
                                            aria-label="<%= t('dashboardNewPage.favoriteFilterLabel') %>">
                                            <svg viewBox="0 0 20 20" aria-hidden="true">
                                                <path d="M10 2.9l2.15 4.36 4.81.7-3.48 3.39.82 4.79L10 14.02 5.7 16.14l.82-4.79L3.04 7.96l4.81-.7L10 2.9z" fill="currentColor"></path>
                                            </svg>
                                        </button>
                                        <div class="workout-library-type">
                                            <button
                                                id="workout-library-activity-trigger"
                                                class="workout-library-sort__trigger workout-library-type__trigger"
                                                type="button"
                                                aria-haspopup="menu"
                                                aria-expanded="false"
                                                aria-label="<%= t('dashboardNewPage.activityTypeFilterLabel') %>"
                                                title="<%= t('dashboardNewPage.activityTypeFilterLabel') %>">
                                                <span id="workout-library-activity-trigger-label" class="visually-hidden"><%= t("dashboardNewPage.activityTypeAll") %></span>
                                                <svg class="workout-library-type__icon" viewBox="0 0 20 20" aria-hidden="true">
                                                    <circle cx="10" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.45"></circle>
                                                    <path d="M10 2.5v3M10 14.5v3M2.5 10h3M14.5 10h3M4.7 4.7l2.1 2.1M13.2 13.2l2.1 2.1M15.3 4.7l-2.1 2.1M6.8 13.2l-2.1 2.1" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"></path>
                                                </svg>
                                                <svg class="workout-library-sort__chevron" viewBox="0 0 20 20" aria-hidden="true">
                                                    <path d="M5.5 7.5L10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                                </svg>
                                            </button>
                                            <div id="workout-library-activity-menu" class="workout-library-sort__menu workout-library-type__menu" hidden>
                                                <% for (const option of [
                                                    ["all", "activityTypeAll"],
                                                    ["cycling", "activityTypeCycling"],
                                                    ["strength_training", "activityTypeStrengthTraining"],
                                                    ["mobility", "activityTypeMobility"],
                                                    ["other", "activityTypeOther"]
                                                ]) { %>
                                                    <button class="workout-library-sort__option" type="button" data-activity-type-option="<%= option[0] %>">
                                                        <span class="workout-library-sort__option-title"><%= t(`dashboardNewPage.${option[1]}`) %></span>
                                                    </button>
                                                <% } %>
                                            </div>
                                            <select id="workout-library-activity-filter" class="form-select workout-library-type__native" aria-label="<%= t('dashboardNewPage.activityTypeFilterLabel') %>">
                                                <option value="all"><%= t("dashboardNewPage.activityTypeAll") %></option>
                                                <option value="cycling"><%= t("dashboardNewPage.activityTypeCycling") %></option>
                                                <option value="strength_training"><%= t("dashboardNewPage.activityTypeStrengthTraining") %></option>
                                                <option value="mobility"><%= t("dashboardNewPage.activityTypeMobility") %></option>
                                                <option value="other"><%= t("dashboardNewPage.activityTypeOther") %></option>
                                            </select>
                                        </div>
                                        <div class="workout-library-type">
                                            <button
                                                id="workout-library-type-trigger"
                                                class="workout-library-sort__trigger workout-library-type__trigger"
                                                type="button"
                                                aria-haspopup="menu"
                                                aria-expanded="false"
                                                aria-label="<%= t('dashboardNewPage.workoutTypeFilterLabel') %>"
                                                title="<%= t('dashboardNewPage.workoutTypeFilterLabel') %>">
                                                <span id="workout-library-type-trigger-label" class="visually-hidden"><%= t("dashboardNewPage.workoutTypeAll") %></span>
                                                <svg class="workout-library-type__icon" viewBox="0 0 20 20" aria-hidden="true">
                                                    <circle cx="4.5" cy="14.25" r="2.75" fill="none" stroke="currentColor" stroke-width="1.45"></circle>
                                                    <circle cx="15.5" cy="14.25" r="2.75" fill="none" stroke="currentColor" stroke-width="1.45"></circle>
                                                    <path d="M4.5 14.25L8.2 8.2h3.25l4.05 6.05M8.2 8.2l3.1 6.05H4.5M10.15 6.2h2.45" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"></path>
                                                </svg>
                                                <svg class="workout-library-sort__chevron" viewBox="0 0 20 20" aria-hidden="true">
                                                    <path d="M5.5 7.5L10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                                </svg>
                                            </button>
                                            <div id="workout-library-type-menu" class="workout-library-sort__menu workout-library-type__menu" hidden>
                                                <button class="workout-library-sort__option" type="button" data-workout-type-option="all">
                                                    <span class="workout-library-sort__option-title"><%= t("dashboardNewPage.workoutTypeAll") %></span>
                                                </button>
                                                <button class="workout-library-sort__option" type="button" data-workout-type-option="indoor">
                                                    <span class="workout-library-sort__option-title"><%= t("dashboardNewPage.workoutTypeIndoor") %></span>
                                                </button>
                                                <button class="workout-library-sort__option" type="button" data-workout-type-option="road">
                                                    <span class="workout-library-sort__option-title"><%= t("dashboardNewPage.workoutTypeRoad") %></span>
                                                </button>
                                                <button class="workout-library-sort__option" type="button" data-workout-type-option="mountain">
                                                    <span class="workout-library-sort__option-title"><%= t("dashboardNewPage.workoutTypeMountain") %></span>
                                                </button>
                                                <button class="workout-library-sort__option" type="button" data-workout-type-option="motorsport">
                                                    <span class="workout-library-sort__option-title"><%= t("dashboardNewPage.workoutTypeMotorsport") %></span>
                                                </button>
                                                <button class="workout-library-sort__option" type="button" data-workout-type-option="unknown">
                                                    <span class="workout-library-sort__option-title"><%= t("dashboardNewPage.workoutTypeUnknown") %></span>
                                                </button>
                                            </div>
                                            <select
                                                id="workout-library-type-filter"
                                                class="form-select workout-library-type__native"
                                                aria-label="<%= t('dashboardNewPage.workoutTypeFilterLabel') %>">
                                                <option value="all"><%= t("dashboardNewPage.workoutTypeAll") %></option>
                                                <option value="indoor"><%= t("dashboardNewPage.workoutTypeIndoor") %></option>
                                                <option value="road"><%= t("dashboardNewPage.workoutTypeRoad") %></option>
                                                <option value="mountain"><%= t("dashboardNewPage.workoutTypeMountain") %></option>
                                                <option value="motorsport"><%= t("dashboardNewPage.workoutTypeMotorsport") %></option>
                                                <option value="unknown"><%= t("dashboardNewPage.workoutTypeUnknown") %></option>
                                            </select>
                                        </div>
                                        <div class="workout-library-terrain-filter">
                                            <button
                                                id="workout-library-terrain-trigger"
                                                class="workout-library-sort__trigger workout-library-terrain-filter__trigger"
                                                type="button"
                                                aria-haspopup="menu"
                                                aria-expanded="false"
                                                aria-label="<%= t('dashboardNewPage.terrainProfileFilterLabel') %>"
                                                title="<%= t('dashboardNewPage.terrainProfileFilterLabel') %>">
                                                <span id="workout-library-terrain-trigger-label" class="visually-hidden"><%= t("dashboardNewPage.terrainProfileAll") %></span>
                                                <svg class="workout-library-terrain-filter__icon" viewBox="0 0 20 20" aria-hidden="true">
                                                    <path d="M2.4 15.8l4.4-6.4 2.35 3.05L12.4 5.1l5.2 10.7H2.4z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"></path>
                                                </svg>
                                                <svg class="workout-library-sort__chevron" viewBox="0 0 20 20" aria-hidden="true">
                                                    <path d="M5.5 7.5L10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                                </svg>
                                            </button>
                                            <div id="workout-library-terrain-menu" class="workout-library-sort__menu workout-library-terrain-filter__menu" hidden>
                                                <% for (const option of [
                                                    ["all", "terrainProfileAll"],
                                                    ["flat", "terrainProfileFlat"],
                                                    ["rolling", "terrainProfileRolling"],
                                                    ["mountainous", "terrainProfileMountainous"],
                                                    ["altitude_missing", "terrainProfileAltitudeMissing"],
                                                    ["altitude_invalid", "terrainProfileAltitudeInvalid"]
                                                ]) { %>
                                                    <button class="workout-library-sort__option" type="button" data-terrain-profile-option="<%= option[0] %>">
                                                        <span class="workout-library-sort__option-title"><%= t(`dashboardNewPage.${option[1]}`) %></span>
                                                    </button>
                                                <% } %>
                                            </div>
                                            <select
                                                id="workout-library-terrain-filter"
                                                class="form-select workout-library-terrain-filter__native"
                                                aria-label="<%= t('dashboardNewPage.terrainProfileFilterLabel') %>">
                                                <option value="all"><%= t("dashboardNewPage.terrainProfileAll") %></option>
                                                <option value="flat"><%= t("dashboardNewPage.terrainProfileFlat") %></option>
                                                <option value="rolling"><%= t("dashboardNewPage.terrainProfileRolling") %></option>
                                                <option value="mountainous"><%= t("dashboardNewPage.terrainProfileMountainous") %></option>
                                                <option value="altitude_missing"><%= t("dashboardNewPage.terrainProfileAltitudeMissing") %></option>
                                                <option value="altitude_invalid"><%= t("dashboardNewPage.terrainProfileAltitudeInvalid") %></option>
                                            </select>
                                        </div>
                                        <div class="workout-library-terrain-filter">
                                            <button
                                                id="workout-library-intensity-trigger"
                                                class="workout-library-sort__trigger workout-library-terrain-filter__trigger"
                                                type="button"
                                                aria-haspopup="menu"
                                                aria-expanded="false"
                                                aria-label="<%= t('dashboardNewPage.intensityProfileFilterLabel') %>"
                                                title="<%= t('dashboardNewPage.intensityProfileFilterLabel') %>">
                                                <span id="workout-library-intensity-trigger-label" class="visually-hidden"><%= t("dashboardNewPage.intensityProfileAll") %></span>
                                                <svg class="workout-library-terrain-filter__icon" viewBox="0 0 20 20" aria-hidden="true">
                                                    <path d="M11.3 1.9L4.9 11h4.25l-.55 7.1 6.5-9.35h-4.3l.5-6.85z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"></path>
                                                </svg>
                                                <svg class="workout-library-sort__chevron" viewBox="0 0 20 20" aria-hidden="true">
                                                    <path d="M5.5 7.5L10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                                </svg>
                                            </button>
                                            <div id="workout-library-intensity-menu" class="workout-library-sort__menu workout-library-terrain-filter__menu" hidden>
                                                <% for (const option of [
                                                    ["all", "intensityProfileAll"],
                                                    ["recovery", "intensityProfileRecovery"],
                                                    ["endurance", "intensityProfileEndurance"],
                                                    ["tempo", "intensityProfileTempo"],
                                                    ["threshold", "intensityProfileThreshold"],
                                                    ["vo2max", "intensityProfileVo2max"],
                                                    ["anaerobic", "intensityProfileAnaerobic"],
                                                    ["unknown", "intensityProfileUnknown"]
                                                ]) { %>
