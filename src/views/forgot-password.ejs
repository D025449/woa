<!DOCTYPE html>
<html lang="<%= i18n?.locale || 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/favicon") %>
    <title><%= t("passwordReset.request.title") %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/ui-system.css?v=atlas-blue-4">
    <link rel="stylesheet" href="/css/auth.css?v=password-reset-1">
</head>
<body class="auth-page">
    <nav class="navbar navbar-dark auth-topbar">
        <div class="container-fluid px-3 px-xl-4">
            <span class="navbar-brand"><%= t("passwordReset.brand") %></span>
            <a class="btn btn-outline-light btn-sm" href="/login"><%= t("passwordReset.backToSignIn") %></a>
        </div>
    </nav>

    <main class="container py-4 py-lg-5">
        <div class="auth-shell">
            <section class="auth-hero mb-4">
                <div>
                    <p class="auth-kicker"><%= t("passwordReset.request.heroKicker") %></p>
                    <h1 class="auth-title"><%= t("passwordReset.request.heroTitle") %></h1>
                    <p class="auth-subtitle"><%= t("passwordReset.request.heroSubtitle") %></p>
                </div>
                <span class="auth-chip">
                    <span class="auth-chip-label"><%= t("passwordReset.chipLabel") %></span>
                    <span><%= t("passwordReset.request.chipValue") %></span>
                </span>
            </section>

            <section class="auth-card">
                <div class="auth-card-header">
                    <h2 class="auth-card-title"><%= t("passwordReset.request.cardTitle") %></h2>
                </div>
                <div class="auth-card-body">
                    <% if (typeof error !== "undefined" && error) { %>
                        <div class="alert alert-danger"><%= error %></div>
                    <% } %>
                    <form method="POST" action="/forgot-password">
                        <div class="mb-3">
                            <label class="form-label" for="password-reset-username"><%= t("passwordReset.username") %></label>
                            <input id="password-reset-username" type="text" class="form-control" name="username" autocomplete="username" maxlength="320" required autofocus>
                            <div class="form-text"><%= t("passwordReset.request.neutralHint") %></div>
                        </div>
                        <button class="btn btn-primary w-100 auth-primary-btn"><%= t("passwordReset.request.submit") %></button>
                    </form>
                    <div class="text-center mt-3">
                        <a href="/login"><%= t("passwordReset.backToSignIn") %></a>
                    </div>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
