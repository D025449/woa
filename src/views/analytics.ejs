<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/favicon") %>

    <title><%= t("analyticsPage.title") %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>
    <link href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="stylesheet" href="/css/ui-system.css?v=atlas-blue-4">
    <link rel="stylesheet" href="/css/analytics.css?v=atlas-blue-14">

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

</head>

<body class="analytics-page">

    <% if (isAuthenticated) { %>

        <%- include("partials/app-topbar", {
            title: t("analyticsPage.topbarTitle"),
            currentPage: "analytics",
            userInfo,
            showDashboardNewLink: true
        }) %>
        <!-- Content -->
        <div class="container-fluid px-3 px-xl-4 py-4">
            <div id="analytics-shell" class="analytics-shell ui-page-shell">

                <section id="analytics-hero" class="analytics-hero ui-hero ui-hero--compact">
                    <div>
                        <p class="analytics-kicker ui-hero__kicker"><%= t("analyticsPage.kicker") %></p>
                        <h1 class="analytics-title ui-hero__title"><%= t("analyticsPage.mainTitle") %></h1>
                        <p class="analytics-subtitle ui-hero__subtitle">
                            <%= t("analyticsPage.subtitle") %>
                        </p>
                    </div>
                    <div class="analytics-hero-controls">
                        <div class="analytics-voice-control">
                            <button id="analytics-voice-button" class="analytics-voice-button" type="button"
                                aria-label="<%= t("analyticsPage.voiceLabel") %>"
                                title="<%= t("analyticsPage.voiceHint") %>">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 14.5a3.5 3.5 0 0 0 3.5-3.5V5.5a3.5 3.5 0 1 0-7 0V11a3.5 3.5 0 0 0 3.5 3.5Z" />
                                    <path d="M5.75 10.75a6.25 6.25 0 0 0 12.5 0M12 17v3.25M8.75 20.25h6.5" />
                                </svg>
                            </button>
                            <div id="analytics-voice-feedback" class="analytics-voice-feedback" role="status" aria-live="polite" hidden>
                                <strong id="analytics-voice-status"><%= t("analyticsPage.voiceHint") %></strong>
                                <span id="analytics-voice-transcript"></span>
                            </div>
                        </div>
                        <div class="analytics-grouping-control" role="group" aria-label="<%= t("analyticsPage.groupingLabel") %>">
                            <div class="btn-group analytics-toggle-group ui-toggle-group">
                                <input type="radio" class="btn-check" name="analytics-grouping" id="analytics-g-week" value="week">
                                <label class="btn btn-outline-primary btn-sm" for="analytics-g-week"><%= t("analyticsPage.toggleWeek") %></label>
                                <input type="radio" class="btn-check" name="analytics-grouping" id="analytics-g-month" value="month">
                                <label class="btn btn-outline-primary btn-sm" for="analytics-g-month"><%= t("analyticsPage.toggleMonth") %></label>
                                <input type="radio" class="btn-check" name="analytics-grouping" id="analytics-g-quarter" value="quarter">
                                <label class="btn btn-outline-primary btn-sm" for="analytics-g-quarter"><%= t("analyticsPage.toggleQuarter") %></label>
                                <input type="radio" class="btn-check" name="analytics-grouping" id="analytics-g-year" value="year">
                                <label class="btn btn-outline-primary btn-sm" for="analytics-g-year"><%= t("analyticsPage.toggleYear") %></label>
                            </div>
                        </div>
                        <div class="analytics-time-range-display" aria-label="<%= t("analyticsPage.timeRangeLabel") %>">
                            <output id="analytics-time-range-summary" aria-live="polite"></output>
                        </div>
                    </div>
                    <div class="ui-hero__art" aria-hidden="true">
                        <svg viewBox="0 0 64 64" fill="none">
                            <defs>
                                <linearGradient id="analyticsHeroGradient" x1="10" y1="50" x2="54" y2="12" gradientUnits="userSpaceOnUse">
                                    <stop stop-color="#176fbe" />
                                    <stop offset="1" stop-color="#2563eb" />
                                </linearGradient>
                            </defs>
                            <path d="M12 50H54" stroke="rgba(148,163,184,0.34)" stroke-width="3" stroke-linecap="round" />
                            <path d="M16 42L26 31L34 35L48 19" stroke="url(#analyticsHeroGradient)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M16 28L24 24L32 27L44 16" stroke="rgba(37,99,235,0.26)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="48" cy="19" r="4" fill="#2563eb" />
                        </svg>
                    </div>
                </section>

                <section id="analytics-workspace" class="analytics-workspace">
                <div id="analytics-chart-grid" class="analytics-chart-grid analytics-chart-grid--timeline">
                    <article class="analytics-surface ui-surface ui-surface--gradient analytics-grid-panel analytics-combined-chart-panel">
                        <div class="analytics-body analytics-body--load-model">
                            <div id="ctl-chart"></div>
                        </div>

                        <div class="analytics-combined-chart-divider" aria-hidden="true"></div>
                        <div class="analytics-body">
                            <div id="cp-chart"></div>
                        </div>
                    </article>

                    <article class="analytics-surface ui-surface ui-surface--gradient analytics-grid-panel" hidden>
                        <div class="analytics-section-header ui-section-header">
                            <div>
                                <span class="analytics-eyebrow ui-eyebrow"><%= t("analyticsPage.thresholdEyebrow") %></span>
                                <h2 class="analytics-section-title ui-title"><%= t("analyticsPage.thresholdTitle") %></h2>
                                <p class="analytics-section-copy ui-copy">
                                    <%= t("analyticsPage.thresholdCopy") %>
                                </p>
                            </div>

                            <div class="btn-group analytics-toggle-group ui-toggle-group" role="group">
                                <input type="radio" class="btn-check" name="grouping0" id="g-week0" value="week">
                                <label class="btn btn-outline-primary btn-sm" for="g-week0"><%= t("analyticsPage.toggleWeek") %></label>

                                <input type="radio" class="btn-check" name="grouping0" id="g-month0" value="month">
                                <label class="btn btn-outline-primary btn-sm" for="g-month0"><%= t("analyticsPage.toggleMonth") %></label>

                                <input type="radio" class="btn-check" name="grouping0" id="g-quarter0" value="quarter">
                                <label class="btn btn-outline-primary btn-sm" for="g-quarter0"><%= t("analyticsPage.toggleQuarter") %></label>

                                <input type="radio" class="btn-check" name="grouping0" id="g-year0" value="year" checked>
                                <label class="btn btn-outline-primary btn-sm" for="g-year0"><%= t("analyticsPage.toggleYear") %></label>
                            </div>
                        </div>

                        <div class="analytics-body">
                            <div id="ftp-chart"></div>
                        </div>
                    </article>

                </div>

                <div id="analytics-detail-column" class="analytics-detail-column">
                <div id="analytics-detail-placeholder" class="analytics-workspace-placeholder analytics-surface ui-surface ui-surface--gradient">
                    <span class="analytics-eyebrow ui-eyebrow"><%= t("analyticsPage.detailEyebrow") %></span>
                    <strong><%= t("analyticsPage.detailInitial") %></strong>
                </div>

                <section id="analytics-detail" class="analytics-detail" hidden>
                    <div class="analytics-detail-toolbar">
                        <div>
                            <span class="analytics-eyebrow ui-eyebrow"><%= t("analyticsPage.detailEyebrow") %></span>
                            <strong id="analytics-detail-context"><%= t("analyticsPage.detailTitle") %></strong>
                        </div>
                        <button id="analytics-detail-close" type="button" class="btn btn-outline-secondary btn-sm">
                            <%= t("analyticsPage.backToPeriod") %>
                        </button>
                    </div>
                <section id="analytics-focus-grid" class="analytics-focus-grid">
                    <article class="analytics-surface ui-surface ui-surface--gradient analytics-focus-panel">
                        <div class="analytics-section-header ui-section-header">
                            <div>
                                <span class="analytics-eyebrow ui-eyebrow"><%= t("analyticsPage.workoutContextEyebrow") %></span>
                                <h2 class="analytics-section-title ui-title"><%= t("analyticsPage.workoutContextTitle") %></h2>
                                <p class="analytics-section-copy ui-copy">
                                    <%= t("analyticsPage.workoutContextCopy") %>
                                </p>
                            </div>
                            <div id="analytics-workout-meta" class="analytics-workout-meta" hidden aria-live="polite">
                                <strong id="analytics-workout-id"></strong>
                                <span aria-hidden="true">·</span>
                                <time id="analytics-workout-date"></time>
                            </div>
                        </div>

                        <div class="analytics-body">
                            <div id="workout-chart"></div>
                        </div>
                    </article>

                    <aside id="analytics-map-panel" class="analytics-surface ui-surface ui-surface--gradient analytics-focus-panel">
                        <div class="analytics-section-header ui-section-header">
                            <div>
                                <span class="analytics-eyebrow ui-eyebrow"><%= t("analyticsPage.spatialEyebrow") %></span>
                                <h2 class="analytics-section-title ui-title"><%= t("analyticsPage.spatialTitle") %></h2>
                                <p class="analytics-section-copy ui-copy">
                                    <%= t("analyticsPage.spatialCopy") %>
                                </p>
                            </div>
                        </div>

                        <div class="analytics-body">
                            <div id="workout-map"></div>
                        </div>
                    </aside>
                </section>
                </section>
                </div>

                <aside id="analytics-period-inspector" class="analytics-period-inspector analytics-surface ui-surface ui-surface--gradient">
                    <div class="analytics-section-header ui-section-header">
                        <div>
                            <span class="analytics-eyebrow ui-eyebrow"><%= t("analyticsPage.periodEyebrow") %></span>
                            <h2 id="analytics-period-title" class="analytics-section-title ui-title"><%= t("analyticsPage.periodTitle") %></h2>
                            <p id="analytics-period-summary" class="analytics-section-copy ui-copy" aria-live="polite"></p>
                            <div id="analytics-period-kpis" class="analytics-period-kpis" hidden></div>
                            <div id="analytics-period-zones" class="analytics-period-zones" hidden>
                                <span class="analytics-period-power__label"><%= t("analyticsPage.distributionAxis") %></span>
                                <div id="analytics-period-zone-bar" class="analytics-period-zone-bar"></div>
                                <div id="analytics-period-zone-values" class="analytics-period-zone-values"></div>
                            </div>
                            <div id="analytics-period-power" class="analytics-period-power" hidden>
                                <span class="analytics-period-power__label"><%= t("analyticsPage.periodPowerProfileLabel") %></span>
                                <div id="analytics-period-power-values" class="analytics-period-power__values"></div>
                            </div>
                        </div>
                    </div>
                    <div id="analytics-period-workouts" class="analytics-period-workouts" aria-live="polite">
                        <p class="analytics-period-empty"><%= t("analyticsPage.periodInitial") %></p>
                    </div>
                    <div id="analytics-period-load-more" class="analytics-period-load-more" hidden>
                        <span id="analytics-period-page-status" class="analytics-period-page-status" hidden></span>
                        <button id="analytics-period-load-more-button" type="button" class="btn btn-outline-primary btn-sm">
                            <%= t("analyticsPage.loadMore") %>
                        </button>
                    </div>
                </aside>
                </section>
            </div>
        </div>

        <% } else { %>

            <div class="container py-5 text-center">

                <h3 class="mb-4"><%= t("common.auth.pleaseSignIn") %></h3>

                <a class="btn btn-primary" href="/login">
                    <%= t("analyticsPage.signIn") %>
                </a>

            </div>

            <% } %>

        
                <!-- Charts -->

                <script src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js"></script>
                <script>
                    window.__I18N = <%- JSON.stringify(i18n || { locale: "en", messages: {} }) %>;
                </script>
                <script type="module" src="/js/analytics-ui.js?v=atlas-blue-20"></script>
                <!--script type="module" src="/js/dashboard-table.js"></script-->

</body>

</html>
