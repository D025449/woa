<!DOCTYPE html>
<html lang="<%= i18n?.locale || 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/favicon") %>
    <title><%= t("uploadPage.garmin.pageTitle") %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/ui-system.css?v=atlas-blue-4">
    <link rel="stylesheet" href="/css/upload.css?v=separate-import-1">
</head>
<body class="upload-page" data-import-layout="simple">
    <%- include("partials/app-topbar", {
        title: t("uploadPage.garmin.pageTitle"),
        currentPage: "upload",
        userInfo,
        showDashboardNewLink: true
    }) %>
    <main class="container-fluid px-3 px-xl-4 py-4 upload-client-container">
        <div id="upload-shell" class="upload-shell ui-page-shell">
            <section class="upload-hero ui-hero ui-hero--compact">
                <div>
                    <h1 class="upload-title ui-hero__title"><%= t("uploadPage.garmin.pageTitle") %></h1>
                    <p class="upload-subtitle ui-hero__subtitle"><%= t("uploadPage.garmin.pageCopy") %></p>
                </div>
            </section>
            <section class="upload-stage ui-surface ui-surface--gradient" aria-labelledby="garmin-import-title">
                <div class="upload-stage-body">
                    <h2 id="garmin-import-title" class="h5"><%= t("uploadPage.garmin.title") %></h2>
                    <p class="small"><%= t(garminConfigured ? "uploadPage.garmin.connectionSaved" : "uploadPage.garmin.connectionMissing") %></p>
                    <a class="small mb-3" href="/profile#garmin-settings-title"><%= t(garminConfigured ? "uploadPage.garmin.setup" : "uploadPage.garmin.connect") %></a>
                    <% if (garminConfigured) { %>
                        <div class="mt-3">
                            <button id="garmin-load" type="button" class="btn btn-outline-primary"><%= t("uploadPage.garmin.load") %></button>
                        </div>
                        <p id="garmin-import-status" class="small mt-2" role="status"></p>
                        <ul id="garmin-activities" class="list-group garmin-activity-list mb-3" tabindex="0" aria-labelledby="garmin-import-title"></ul>
                        <div>
                            <button id="garmin-load-more" type="button" class="btn btn-outline-primary mb-3" hidden disabled><%= t("uploadPage.garmin.loadMore") %></button>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="overwriteExistingWorkouts" aria-describedby="garmin-overwrite-help">
                            <label class="form-check-label" for="overwriteExistingWorkouts"><%= t("uploadPage.woaOverwriteExisting") %></label>
                            <div id="garmin-overwrite-help" class="form-text"><%= t("uploadPage.woaOverwriteExistingHelp") %></div>
                        </div>
                        <button id="garmin-import-selected" type="button" class="btn upload-primary-btn align-self-start" disabled><%= t("uploadPage.garmin.importSelected") %></button>
                        <p class="small text-muted mt-2"><%= t("uploadPage.garmin.keepOpen") %></p>
                        <%- include("partials/import-progress") %>
                        <div id="response" class="mt-3"></div>
                    <% } %>
                </div>
            </section>
        </div>
    </main>
    <script>
        window.__I18N = <%- JSON.stringify(i18n || { locale: "en", messages: {} }).replace(/</g, "\\u003c") %>;
    </script>
    <script id="garmin-import-messages" type="application/json"><%- JSON.stringify(i18n?.messages?.uploadPage?.garmin || {}).replace(/</g, "\\u003c") %></script>
    <% if (garminConfigured) { %>
        <script type="module" src="/js/garmin-import-page.js?v=separate-import-1"></script>
    <% } %>
</body>
</html>
