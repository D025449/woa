<section class="profile-surface ui-surface">
    <div class="profile-section-header ui-section-header">
        <div>
            <h2 id="weight-history-title" class="profile-section-title ui-title"><%= t("profile.weightHistory.title") %></h2>
            <p class="profile-section-copy ui-copy"><%= t("profile.weightHistory.copy") %></p>
        </div>
    </div>
    <form id="weight-history-form" class="profile-form row g-3 m-0">
        <div class="col-md-4">
            <label for="weight-history-date" class="form-label"><%= t("profile.weightHistory.date") %></label>
            <input id="weight-history-date" name="validFrom" type="date" min="0001-01-01" max="9999-12-31" required class="form-control">
        </div>
        <div class="col-md-4">
            <label for="weight-history-weight" class="form-label"><%= t("profile.weight") %></label>
            <input id="weight-history-weight" name="weightKg" type="number" min="0.01" max="500" step="0.01" required class="form-control">
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-dark"><%= t("profile.weightHistory.save") %></button>
            <button type="button" id="weight-history-cancel" class="btn btn-outline-secondary" hidden><%= t("profile.weightHistory.cancel") %></button>
        </div>
    </form>
    <div class="profile-weight-body">
        <p id="weight-history-status" role="status" aria-live="polite"></p>
        <div class="profile-weight-scroll" role="region" aria-labelledby="weight-history-title" tabindex="0">
            <ul id="weight-history-list" class="profile-weight-list"></ul>
        </div>
    </div>
</section>